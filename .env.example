# Production API ( /api/v1 is appended automatically if omitted )
VITE_API_URL=https://flow.zentroverse.com

# Local development — legacy lead/bootstrap API
# VITE_API_URL=http://localhost:8787

# Optional override — by default Action Engine uses VITE_API_URL (Express zentroflow-api)
# VITE_ACTION_ENGINE_URL=http://localhost:8787

# Verbose request/response logs in browser console
# VITE_API_DEBUG=true
